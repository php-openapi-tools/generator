{
  "name": "openapi-tools/generator",
  "description": "Package generation tool for OpenAPI Spec based packages",
  "license": "MIT",
  "authors": [
    {
      "name": "Cees-Jan Kiewiet",
      "email": "ceesjank@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "ext-hash": "^8.4",
    "devizzent/cebe-php-openapi": "^1.1",
    "nikic/php-parser": "^5.0",
    "openapi-tools/configuration": "^0.1.0",
    "openapi-tools/contract": "^0.1.0",
    "openapi-tools/gatherer": "^0.1.0",
    "openapi-tools/generator-utils": "^0.1.0",
    "openapi-tools/registry": "^0.1.0",
    "openapi-tools/representation": "^0.1.0",
    "openapi-tools/utils": "^0.1.0"
  },
  "require-dev": {
    "openapi-tools/generator-hydrator": "^0.1.0",
    "openapi-tools/generator-schema": "^0.1.0",
    "openapi-tools/generator-templates": "^0.1.0",
    "shipmonk/coverage-guard": "^1.1.0",
    "wyrihaximus/async-test-utilities": "^13.5.1",
    "wyrihaximus/makefiles": "^0.13.3"
  },
  "autoload": {
    "psr-4": {
      "OpenAPITools\\Generator\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OpenAPITools\\Tests\\Generator\\": "tests/"
    }
  },
  "bin": [
    "bin/openapi-generator"
  ],
  "config": {
    "allow-plugins": {
      "composer/package-versions-deprecated": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "drupol/composer-packages": true,
      "ergebnis/composer-normalize": true,
      "icanhazstring/composer-unused": true,
      "infection/extension-installer": true,
      "mindplay/composer-locator": true,
      "phpstan/extension-installer": true,
      "wyrihaximus/composer-update-bin-autoload-path": true,
      "wyrihaximus/makefiles": true,
      "wyrihaximus/test-utilities": true
    },
    "platform": {
      "php": "8.4.13"
    },
    "sort-packages": true
  },
  "extra": {
    "wyrihaximus": {
      "supported-features": {
        "windows": false
      }
    }
  },
  "scripts": {
    "post-install-cmd": [
      "make on-install-or-update || true"
    ],
    "post-update-cmd": [
      "make on-install-or-update || true"
    ]
  }
}
